<Project Sdk="Microsoft.NET.Sdk">
    <!-- Logic shared by RosterTool (command line) and the Historic Roster desktop program.
         Also compiles the plugin's Shared/ code (importers, catalog, resolver, content scanner). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>HistoricRosterPlugin</RootNamespace>
        <AssemblyName>HistoricRosterCore</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Encrypts the OpenAI / DeepSeek API keys for your Windows user (DPAPI) in the program's settings.json. -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
        <Compile Include="..\HistoricRosterPlugin\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
